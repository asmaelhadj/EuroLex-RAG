# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required by the API only (Phase 6). At least 16 characters. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Qdrant (started by `make up`). Use http://qdrant:6333 from inside Docker Compose.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Ollama. Host install: http://localhost:11434.
# From a container talking to Ollama on the host: http://host.docker.internal:11434.
# Compose `ollama` profile: http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
# Should differ from LLM_MODEL (judge and question-candidate generator).
# JUDGE_MODEL=
# CANDIDATE_MODEL=

# Embedding and reranker models are pinned in configs/*.yaml, not here, for reproducibility.

MAX_QUESTION_CHARS=500
# Questions per minute per client address.
RATE_LIMIT_PER_MINUTE=10
# Experiment config the API serves (the evaluated one by default).
API_CONFIG=configs/e7_threshold.yaml
# Where the UI finds the API (Docker Compose sets http://api:8000 itself).
API_URL=http://localhost:8000
# Cap on answer length and how long the API waits for Ollama.
API_MAX_ANSWER_TOKENS=1024
API_LLM_TIMEOUT_SECONDS=120
# Ollama as seen from the Docker containers (default: Ollama on the host).
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
RANDOM_SEED=42

LOG_LEVEL=INFO
# Local debugging only: logs raw question text, which may contain personal data.
LOG_QUERIES=false

# Optional Langfuse tracing (`uv sync --extra tracing`). Sends the same fields as the logs.
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
